classDiagram
    class Priceable {
        <<interface>>
        +getPrice() double
    }

    class Room {
        <<abstract>>
        -roomNumber: String
        -status: String
        -price: double
        +getRoomNumber() String
        +getStatus() String
        +getPrice() double
        +getType()* String
        +isAvailable() boolean
        +bookRoom() void
        +releaseRoom() void
    }

    class SingleRoom {
        +getType() String
    }

    class DoubleRoom {
        +getType() String
    }

    class DeluxeRoom {
        +getType() String
    }

    class SuiteRoom {
        -luxuryTax: double
        +getType() String
    }

    class Guest {
        -id: int
        -name: String
        -phoneNumber: String
        -email: String
        +getId() int
        +getName() String
        +validateName() void
        +validatePhoneNumber() void
        +validateEmail() void
    }

    class GuestManager {
        -guests: ArrayList~Guest~
        +addGuest(Guest) void
        +findGuestById(int) Guest
        +removeGuestById(int) boolean
        +getAllGuest() ArrayList
    }

    class Reservation {
        -reservationId: int
        -guest: Guest
        -room: Room
        -checkInDate: LocalDate
        -checkOutDate: LocalDate
        -breakfastIncluded: boolean
        -status: String
        +getNumberOfNights() int
        +getReservationDetails() String
        +checkIn() void
        +completeReservation() void
        +cancelReservation() void
        +getPrice() double
    }

    class Invoice {
        -invoiceId: int
        -reservation: Reservation
        -issueDate: LocalDate
        -breakfastRatePerNight: double
        -isPaid: boolean
        +calculateRoomTotal() double
        +calculateBreakfastTotal() double
        +calculateTotalPrice() double
        +printReceipt() void
        +setPaid(boolean) void
    }

    class Hotel {
        -rooms: ArrayList~Room~
        -reservations: ArrayList~Reservation~
        -guestManager: GuestManager
        +addRoom(Room) void
        +getAvailableRooms() List
        +getAvailableRoomsByType(String) List
        +getRoomByMaxPrice(double) List
        +makeReservation() Reservation
        +cancelReservation(int) boolean
        +checkIn(int) boolean
        +checkOut(int) boolean
        +addGuest(Guest) void
    }

    class DatabaseManager {
        -URL: String
        -conn: Connection
        +connect() void
        +createTables() void
        +getConnection() Connection
        +close() void
    }

    class Main {
        +main(String[]) void
    }

    Priceable <|.. Room
    Priceable <|.. Reservation
    Room <|-- SingleRoom
    Room <|-- DoubleRoom
    Room <|-- DeluxeRoom
    Room <|-- SuiteRoom

    Hotel "1" *-- "many" Room : contains
    Hotel "1" *-- "many" Reservation : manages
    Hotel "1" *-- "1" GuestManager : uses
    Hotel --> DatabaseManager : uses
    GuestManager "1" *-- "many" Guest : manages
    Reservation "1" --> "1" Guest : has
    Reservation "1" --> "1" Room : books
    Invoice "1" --> "1" Reservation : bills
    Main --> Hotel : controls